    private void Generar()
    {
        if (cmbReporte.SelectedItem is not IReporte r) return;
        try
        {
            dgv.DataSource = r.Ejecutar();
        }
        catch (Exception ex)
        {
            MessageBox.Show("Error: " + ex.Message);
        }
    }
}
